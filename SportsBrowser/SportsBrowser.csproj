<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <VersionPrefix>1.0</VersionPrefix>
  </PropertyGroup>

  <!-- Build number = git commit count, e.g. 1.0.42. Falls back to .0 if git is unavailable. -->
  <Target Name="SetVersionFromGit" BeforeTargets="GetAssemblyVersion">
    <Exec Command="git rev-list --count HEAD" ConsoleToMSBuild="true" StandardOutputImportance="low" ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitCount" />
    </Exec>
    <PropertyGroup>
      <Version Condition="'$(GitCommitCount)' != ''">$(VersionPrefix).$(GitCommitCount)</Version>
      <Version Condition="'$(GitCommitCount)' == ''">$(VersionPrefix).0</Version>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
  </ItemGroup>

</Project>
